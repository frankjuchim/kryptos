    {
      "id": "W9-L2-01",
      "titel": "Maximum-Puzzle",
      "stufe": 2,
      "kategorie": "implementierung",
      "fallen": ["P1"],
      "inhalt": [{ "t": "text", "md": "Bringe die Zeilen in die richtige Reihenfolge, sodass `m` am Ende das Maximum der (nicht leeren) Reihung `r` ist. **Eine Zeile wird nicht gebraucht.**" }],
      "interaktion": {
        "kind": "order",
        "teile": [
          { "id": "a", "code": "int m = r[0];" },
          { "id": "b", "code": "for (int i = 1; i < r.length; i++) {" },
          { "id": "c", "code": "    if (r[i] > m) m = r[i];" },
          { "id": "d", "code": "}" },
          { "id": "e", "code": "return m;" },
          { "id": "x", "code": "return r[0];" }
        ]
      },
      "loesung": { "reihenfolgen": [["a", "b", "c", "d", "e"]] },
      "erklaerung": [{ "t": "text", "md": "Start mit dem ersten Element, dann alle weiteren vergleichen. `return r[0];` ist ein Distraktor." }]
    },
    {
      "id": "W9-L2-02",
      "titel": "Bug-Hunt: Summe",
      "stufe": 3,
      "kategorie": "implementierung",
      "fallen": ["P6"],
      "inhalt": [
        { "t": "text", "md": "Die Methode soll die Summe aller Werte liefern, stürzt aber ab." },
        { "t": "code", "code": "public static int summe(int[] r) {\n    int s = 0;\n    for (int i = 0; i <= r.length; i++) {\n        s = s + r[i];\n    }\n    return s;\n}", "nummern": true },
        { "t": "text", "md": "Korrektur der Bedingung: `i` [[g1]] `r.length`" }
      ],
      "interaktion": [
        { "kind": "lines", "block": 1, "anzahl": 1, "frage": "a) Tippe die fehlerhafte Zeile an." },
        { "kind": "gaps", "felder": { "g1": { "typ": "text", "breite": 4 } }, "frage": "b) Korrigiere die Bedingung." }
      ],
      "loesung": [{ "zeilen": [3] }, { "g1": ["<"] }],
      "tipps": ["Welcher Index ist bei einer Reihung der Länge n der letzte?"],
      "erklaerung": [{ "t": "text", "md": "In Zeile 3 greift `i <= r.length` im letzten Durchlauf auf `r[r.length]` zu → Laufzeitfehler (P6). Richtig: `i < r.length`." }]
    },
