    {
      "id": "W9-L1-01",
      "titel": "Reihung lesen",
      "stufe": 1,
      "punkte": 10,
      "kategorie": "modulo",
      "fallen": ["P6"],
      "inhalt": [
        { "t": "text", "md": "Gegeben ist die Reihung `r`. Der **gold** markierte Wert steht an Index 2." },
        { "t": "reihung", "werte": [5, 2, 9, 4], "indizes": true, "markiert": { "2": "gold" } },
        { "t": "text", "md": "- Wert an Index 2: [[g1]]\n- Index des Werts 4: [[g2]]\n- `r.length` ist [[g3]]\n- So heißt das Attribut für die Länge: `r.`[[g4]]" },
        { "t": "hinweis", "md": "Der erste Index ist **0**, der letzte `r.length − 1`." }
      ],
      "interaktion": {
        "kind": "gaps",
        "felder": {
          "g1": { "typ": "zahl", "breite": 4 },
          "g2": { "typ": "zahl", "breite": 4 },
          "g3": { "typ": "auswahl", "optionen": ["3", "4", "5"] },
          "g4": { "typ": "text", "breite": 8 }
        }
      },
      "loesung": { "g1": ["9"], "g2": ["3"], "g3": ["4"], "g4": ["length"] },
      "tipps": ["Zähle die Indizes ab 0: 0, 1, 2, 3."],
      "erklaerung": [{ "t": "text", "md": "Index 2 enthält **9**, der Wert 4 steht an Index **3**, die Länge ist **4** (P6: Off-by-one beachten)." }]
    },
    {
      "id": "W9-L1-02",
      "titel": "Trace einer Zählschleife",
      "stufe": 2,
      "kategorie": "verschluesseln",
      "fallen": ["P8"],
      "inhalt": [
        { "t": "code", "code": "int s = 0;\nfor (int i = 1; i <= 3; i++) {\n    s = s + i;\n}", "nummern": true, "markiere": [3] },
        { "t": "tabelle", "kopf": ["i", "s"], "zeilen": [["–", "0"], ["1", "[[c1]]"], ["2", "[[c2]]"], ["3", "[[c3]]"]] },
        { "t": "text", "md": "Welche Schleifenart ist das? [[art]]" },
        { "t": "code", "code": "for (int i = 0; i [[op]] r.length; i++) { … }", "nummern": false }
      ],
      "interaktion": {
        "kind": "gaps",
        "felder": {
          "c1": { "typ": "zahl", "breite": 3 },
          "c2": { "typ": "zahl", "breite": 3 },
          "c3": { "typ": "zahl", "breite": 3 },
          "art": { "typ": "text", "norm": "text", "breite": 14 },
          "op": { "typ": "text", "breite": 3 }
        }
      },
      "loesung": { "c1": ["1"], "c2": ["3"], "c3": ["6"], "art": ["Zählschleife", "for-Schleife", "for"], "op": ["<"] },
      "tipps": ["Trage nach jedem Schleifendurchlauf den neuen Wert von s ein.", "s wächst um 1, dann um 2, dann um 3."],
      "erklaerung": [{ "t": "text", "md": "s: 0 → 1 → 3 → 6. Für alle Indizes einer Reihung gilt `i < r.length` (P6)." }]
    },
    {
      "id": "W9-L1-03",
      "titel": "Struktogramm ergänzen",
      "stufe": 2,
      "kategorie": "struktogramm",
      "fallen": ["P9"],
      "inhalt": [
        { "t": "text", "md": "Das Struktogramm zählt die geraden Zahlen von 1 bis n und gibt die Anzahl zurück." },
        {
          "t": "struktogramm",
          "kopf": "zaehleGerade(n: Ganzzahl): Ganzzahl",
          "rumpf": [
            { "anw": "anzahl ← 0" },
            { "anw": "i ← 1" },
            {
              "solange": "i [[g1]] n",
              "rumpf": [
                { "wenn": "i mod 2 = 0", "dann": [{ "anw": "anzahl ← anzahl + 1" }], "sonst": [{ "aufruf": "zeige(i)" }] },
                { "anw": "i ← i + 1" }
              ]
            },
            { "zaehle": "k von 1 bis 2", "rumpf": [{ "anw": "// nur zur Anschauung" }] },
            { "wiederhole": [{ "anw": "anzahl ← anzahl + 0" }], "bis": "wahr" },
            { "gib": "[[g2]]" }
          ]
        }
      ],
      "interaktion": {
        "kind": "gaps",
        "felder": {
          "g1": { "typ": "auswahl", "optionen": ["<", "≤", ">", "≥"] },
          "g2": { "typ": "text", "breite": 8 }
        }
      },
      "loesung": { "g1": ["≤"], "g2": ["anzahl"] },
      "erklaerung": [{ "t": "text", "md": "Die Schleife läuft **solange i ≤ n**; zurückgegeben wird `anzahl` („gib anzahl zurück“, P9)." }]
    },
    {
      "id": "W9-L1-04",
      "titel": "Konstruktor erkennen",
      "stufe": 1,
      "kategorie": "begriffe",
      "fallen": [],
      "inhalt": [
        { "t": "klassenkarte", "name": "Held", "attribute": ["- name: Zeichenkette", "- leben: Ganzzahl"], "methoden": ["+ c Held(name: Zeichenkette)", "+ getName(): Zeichenkette", "+ nimmSchaden(schaden: Ganzzahl): nichts"] },
        { "t": "text", "md": "Welche Zeile beschreibt den **Konstruktor**?" }
      ],
      "interaktion": {
        "kind": "choice",
        "mehrfach": false,
        "optionen": [
          { "id": "a", "md": "`+ c Held(name: Zeichenkette)`" },
          { "id": "b", "md": "`+ getName(): Zeichenkette`" },
          { "id": "c", "md": "`- leben: Ganzzahl`" }
        ]
      },
      "loesung": { "richtig": ["a"] },
      "erklaerung": [{ "t": "text", "md": "Konstruktoren tragen im Klassendiagramm ein vorangestelltes **c** und heißen wie die Klasse." }]
    },
