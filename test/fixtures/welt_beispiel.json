      "titel": "Maximum-Puzzle",
      "stufe": 2,
      "kategorie": "implementierung",
      "fallen": ["P1"],
      "inhalt": [{ "t": "text", "md": "Bringe die Zeilen in die richtige Reihenfolge, sodass `m` am Ende das Maximum der (nicht leeren) Reihung `r` ist. **Eine Zeile wird nicht gebraucht.**" }],
      "interaktion": {
        "kind": "order",
        "teile": [
          { "id": "a", "code": "int m = r[0];" },
          { "id": "b", "code": "for (int i = 1; i < r.length; i++) {" },
          { "id": "c", "code": "    if (r[i] > m) m = r[i];" },
          { "id": "d", "code": "}" },
          { "id": "e", "code": "return m;" },
          { "id": "x", "code": "return r[0];" }
        ]
      },
      "loesung": { "reihenfolgen": [["a", "b", "c", "d", "e"]] },
      "erklaerung": [{ "t": "text", "md": "Start mit dem ersten Element, dann alle weiteren vergleichen. `return r[0];` ist ein Distraktor." }]
    },
