         ],
         "sonst": []
        },
        {
         "anw": "b ← (b · b) mod n"
        },
        {
         "anw": "exp ← exp / 2   // ganzzahlige Division"
        }
       ]
      },
      {
       "gib": "ergebnis"
      }
     ]
    }
   ]
