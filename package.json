{
  "name": "kryptos",
  "version": "1.1.6",
  "description": "Kryptos – Die Zeitreise der Geheimschriften: Lernplattform Kryptologie (Informatik eA und gA, Niedersachsen) im Verbund InfoLabs",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node test/devportal/dev.js",
    "test": "node --test test/*.test.js",
    "validate": "node scripts/validate.js",
    "krypto:vergleich": "node werkzeuge/krypto/vergleich.js",
    "krypto:pruefwerte": "python3 -I werkzeuge/krypto/pruefwerte.py",
    "krypto:seeds": "python3 -I werkzeuge/krypto/seed_pruefen.py",
    "e2e": "node test/e2e/e2e.js",
    "e2e:portal": "node test/e2e/portal.js",
    "akten": "python3 -I werkzeuge/akten_pdf.py",
    "loesungen": "python3 -I werkzeuge/loesungen_pdf.py",
    "lehrkraft": "python3 -I werkzeuge/lehrkraft_pdf.py",
    "workspaces": "python3 -I werkzeuge/workspaces_erzeugen.py",
    "ide:pruefen": "python3 -I werkzeuge/ide-pruefung/ide_pruefen.py",
    "abdeckung": "node scripts/abdeckung.js",
    "konfig:pruefen": "node src/verbund/konfig_pruefen.js",
    "pruefen": "npm test && npm run validate && npm run krypto:pruefwerte && npm run krypto:seeds && npm run abdeckung && node werkzeuge/krypto/erkenner_bauen.js --pruefen",
    "labor:bilder": "node werkzeuge/material/labor_bilder.js",
    "labor:erkenner": "node werkzeuge/krypto/erkenner_bauen.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "playwright-core": "1.56.1",
    "supertest": "^7.3.1"
  }
}
