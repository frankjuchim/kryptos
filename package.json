{
  "name": "kryptos",
  "version": "0.1.0",
  "description": "Kryptos – Die Zeitreise der Geheimschriften: Lernplattform Kryptologie (Informatik eA und gA, Niedersachsen) im Verbund InfoLabs",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node test/devportal/dev.js",
    "test": "node --test test/*.test.js",
    "validate": "node scripts/validate.js",
    "krypto:vergleich": "node werkzeuge/krypto/vergleich.js",
    "krypto:pruefwerte": "python3 -I werkzeuge/krypto/pruefwerte.py",
    "e2e": "node test/e2e/e2e.js",
    "pruefen": "npm test && npm run validate && npm run krypto:pruefwerte"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "playwright-core": "1.56.1",
    "supertest": "^7.3.1"
  }
}
